{
  "$schema": "https://raw.githubusercontent.com/Pocky-l/diegesis/main/docs/schema/scene.schema.json",
  "$comment": "Farm & Charm's cutting board (1.21.1) is the block itself (base x 1..11, z 3..13, handle x 11..15, 1 px high, facing north). The scene draws what lies on it by code, as Hands-On Delight's board does: the item built from its icon (item), or a log as a block at 0.65 of its size (item_block); the cook's knife (knife_turn turns it along the mark to cut) or axe (tool_turn); the layers of a dish; the tool stuck into the board as the board's renderer stands it (stuck); lift_N are ghosts of what comes off the board or bounces back. mouth catches stacks let go on the board (the slot hand stays empty), surface the clicks of an empty hand. The camera, book and badge stand to the board as the pot's stand to the pot, moved down with it: going over from one to the other, the book keeps its place on the screen.",
  "work_plane": 3,
  "idle_visible": true,
  "camera": {
    "position": [7.5, 35.5, -21],
    "target": [7.5, 1, 8],
    "fov": 30
  },
  "interface": {
    "hide_player": true,
    "inventory_panel": false,
    "hover_outline": false
  },
  "inventory_drawer": {
    "side": "bottom",
    "style": "minimal",
    "always_open": true,
    "compact": true,
    "background": "#00000000",
    "slot_color": "#8C1E140C"
  },
  "nodes": [
    {
      "id": "mouth",
      "drop_zone": "hand",
      "collider": {"from": [1, 0, 1], "to": [15, 5.2, 15]}
    },
    {
      "id": "surface",
      "collider": {"from": [1, 0, 1], "to": [15, 5, 15]}
    },
    {
      "$comment": "Everything that lies or works on the board, moved by the code to the middle of the board's base as the scene turns to the cook (BoardBehavior.placeWork).",
      "id": "work",
      "pos": [0, 0, 0],
      "pickable": false,
      "children": [
        {"id": "pile", "pos": [6, 1.01, 8], "rotation": [0, 17, 0], "pickable": false, "hidden": true},
        {"id": "item", "pos": [6, 1.01, 8], "pickable": false, "hidden": true},
        {"id": "item_block", "pos": [6, 3.61, 8], "scale": 0.65, "pickable": false, "hidden": true},
        {"$comment": "A log stripped whole leaving the board for the cook.",
          "id": "block_gone", "pos": [6, 3.61, 8], "scale": 0.65, "pickable": false, "hidden": true},
        {"id": "marks", "pos": [6, 1.01, 8], "pickable": false, "hidden": true},
        {"id": "item_gone", "pos": [6, 1.01, 8], "pickable": false, "hidden": true},
        {
          "id": "lift",
          "pos": [6, 1.01, 8],
          "repeat": {"count": [1, 3, 1], "step": [0, 0, 0]},
          "pickable": false,
          "hidden": true
        },
        {
          "id": "layer",
          "pos": [6, 1.01, 8],
          "repeat": {"count": [1, 5, 1], "step": [0, 0.65, 0]},
          "pickable": false,
          "hidden": true
        },
        {
          "$comment": "The tool stuck into the board, stood as Farm & Charm's renderer stands it: upright through the item's place, edge down, at half its size; turned by the code to the board's facing.",
          "id": "stuck",
          "pos": [6, 3.2, 8],
          "scale": 0.5,
          "pickable": false,
          "hidden": true
        },
        {
          "id": "tool_turn",
          "pos": [6, 1, 8],
          "pickable": false,
          "children": [
            {"$comment": "The axe, posed by code for its strip along the log (ToolStroke).",
              "id": "tool", "scale": 0.45, "pickable": false, "hidden": true}
          ]
        },
        {
          "id": "knife_turn",
          "pos": [6, 1, 8],
          "pickable": false,
          "children": [
            {"id": "knife", "rotation": [20, 0, -135], "scale": 0.45, "pickable": false, "hidden": true}
          ]
        }
      ]
    },
    {"id": "badge", "pos": [-1.1, 9.0, 4.6], "rotation": [-50, 0, 0], "pickable": false},
    {"id": "dial_track", "pos": [-1.1, 9.02, 4.58], "rotation": [-50, 0, 0], "pickable": false},
    {"id": "dial", "pos": [-1.1, 9.04, 4.56], "rotation": [-50, 0, 0], "pickable": false},
    {"$comment": "The badge's pale count of what is still to come.",
      "id": "dial_more", "pos": [-1.1, 9.05, 4.55], "rotation": [-50, 0, 0], "pickable": false},
    {
      "id": "preview",
      "pos": [-1.1, 9.08, 4.52],
      "rotation": [40, 0, 0],
      "scale": 0.125,
      "hidden": true,
      "collider": {"from": [-12, -12, -12], "to": [12, 12, 12]}
    },
    {
      "id": "book_open",
      "pos": [15.83, 15.72, -4],
      "rotation": [-50, 0, 0],
      "scale": 0.69,
      "hidden": true,
      "collider": {"from": [-5.3, -0.4, -3.9], "to": [5.3, 1.4, 3.9]}
    }
  ]
}
